{
  "name": "uimaneger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ローカルで動く リアルタイムプレビュー × 自然言語UI編集 アプリ",
  "packageManager": "npm@11.10.1",
  "engines": {
    "node": ">=22.18.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "start:prod": "npm run build && tsx server/index.ts --production",
    "policy": "node scripts/package-policy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/runner-selftest.mjs && node scripts/resolver-selftest.mjs && vitest run",
    "test:ci": "node --throw-deprecation scripts/runner-selftest.mjs && node --throw-deprecation scripts/resolver-selftest.mjs && node --throw-deprecation node_modules/vitest/vitest.mjs run",
    "sbom": "node scripts/sbom.mjs",
    "verify": "npm run policy && node scripts/third-party-notices.mjs --check && npm run typecheck && npm run test:ci && npm run build",
    "audit": "npm audit --audit-level=moderate",
    "e2e": "playwright test",
    "notices": "node scripts/third-party-notices.mjs",
    "runtime-matrix": "node --import tsx scripts/runtime-matrix.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.106.0",
    "@hono/node-server": "2.1.9",
    "hono": "4.13.19",
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.7",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
